# runtime
MYSQL_PASSWORD=your_password
DB_SLOW_THRESHOLD=200ms
DB_LOG_LEVEL=warn

# Docker image build (mainland China defaults; override for overseas)
GOPROXY=https://goproxy.cn,direct,https://goproxy.io,direct
GOSUMDB=sum.golang.google.cn
# GO_IMAGE=golang:1.25.7-alpine
# RUNTIME_IMAGE=alpine:3.22
# APK_MIRROR=mirrors.aliyun.com
# Optional image rewrite when Hub is blocked, e.g.:
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.25.7-alpine
# RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.22

# Redis
# Preferred for managed/cloud Redis: a single connection string.
#   rediss://<user>:<password>@<host>:6379/<db>   (TLS)
#   redis://<user>:<password>@<host>:6379/<db>    (plaintext)
# When REDIS_URL is set, the redis.addr (and other discrete redis fields) in
# config.yml are IGNORED, so a localhost default cannot shadow the cloud host.
# REDIS_URL=rediss://default:your_password@your-redis-host:6379/0
REDIS_URL=
# Discrete overrides. These are environment variables, so any of them beats the
# corresponding field parsed from REDIS_URL.
REDIS_ADDR=
REDIS_USERNAME=
REDIS_PASSWORD=
# REDIS_TLS=true forces TLS for REDIS_ADDR/redis:// forms. Must be a valid
# boolean (true/false/1/0) — anything else fails startup instead of silently
# falling back to plaintext.
REDIS_TLS=

# inventory reconcile
INVENTORY_RECONCILE_ENABLED=true
INVENTORY_RECONCILE_INTERVAL=5m
INVENTORY_RECONCILE_TIMEOUT=3s

# RabbitMQ and order timeout
RABBITMQ_URL=amqp://order_app:order_dev_password@127.0.0.1:5672/
RABBITMQ_USER=order_app
RABBITMQ_PASSWORD=order_dev_password
ORDER_TIMEOUT_DELAY=30m

# JWT
JWT_SECRET=replace_with_a_32_plus_chars_random_secret

# Go runtime profiling (pprof). OFF by default.
# /debug/pprof exposes goroutine stacks, heap contents and a CPU sampler, so
# enabling it is opening it. Addr must be loopback - startup fails otherwise,
# which is why enabling this on a cloud host does not open a remote port.
# Reach a remote instance through a tunnel:
#   ssh -L 6060:127.0.0.1:6060 <host>
# PPROF_ENABLED must be a real boolean (true/false/1/0); anything else fails
# startup rather than silently reading as off.
PPROF_ENABLED=false
PPROF_ADDR=127.0.0.1:6060

# test
MYSQL_TEST_PASSWORD=your_password
MYSQL_TEST_DATABASE=go_order_management_system_test
RUN_RABBITMQ_TEST=0
